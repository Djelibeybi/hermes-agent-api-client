{
  "model_profile": "adaptive",
  "commit_docs": true,
  "parallelization": true,
  "search_gitignored": false,
  "brave_search": false,
  "firecrawl": false,
  "exa_search": false,
  "git": {
    "branching_strategy": "phase",
    "create_tag": false,
    "phase_branch_template": "feat/phase-{phase}-{slug}",
    "milestone_branch_template": "release/{milestone}-{slug}",
    "quick_branch_template": null
  },
  "workflow": {
    "research": true,
    "plan_check": true,
    "verifier": true,
    "nyquist_validation": true,
    "auto_advance": false,
    "node_repair": true,
    "node_repair_budget": 2,
    "ui_phase": false,
    "ui_safety_gate": false,
    "ai_integration_phase": true,
    "human_verify_mode": "end-of-phase",
    "context_guard_mode": "warn",
    "text_mode": false,
    "research_before_questions": true,
    "discuss_mode": "discuss",
    "skip_discuss": false,
    "code_review": true,
    "code_review_depth": "standard",
    "code_review_command": null,
    "pattern_mapper": true,
    "plan_bounce": false,
    "plan_bounce_script": null,
    "plan_bounce_passes": 2,
    "auto_prune_state": true,
    "post_planning_gaps": true,
    "security_enforcement": true,
    "security_asvs_level": 1,
    "security_block_on": "high",
    "use_worktrees": true,
    "_auto_chain_active": false,
    "tdd_mode": true,
    "ui_review": false,
    "subagent_timeout": 900000,
    "max_discuss_passes": 5
  },
  "ship": {
    "pr_body_sections": []
  },
  "hooks": {
    "context_warnings": true
  },
  "project_code": null,
  "phase_naming": "sequential",
  "agent_skills": {},
  "claude_md_path": "./.claude/CLAUDE.md",
  "plan_review": {
    "source_grounding": true,
    "source_grounding_authority": "grep"
  },
  "mode": "interactive",
  "granularity": "standard",
  "resolve_model_ids": "omit",
  "runtime": "claude",
  "intel": {
    "enabled": true
  },
  "graphify": {
    "enabled": false,
    "auto_update": true
  },
  "model_profile_overrides": {
    "codex": {},
    "claude": {
      "opus": "claude-opus-5-5",
      "sonnet": "claude-sonnet-5-5",
      "haiku": "claude-haiku-5-5"
    }
  },
  "model_policy": {
    "provider": "custom",
    "high": "claude-opus-5-5",
    "medium": "claude-sonnet-5-5",
    "low": "claude-haiku-5-5"
  },
  "review": {
    "models": {
      "opencode": "openrouter/z-ai/glm-5.3-flash",
      "codex": "gpt-6.1-sol"
    }
  },
  "response_language": "English (Australian)",
  "context_window": 1000000
}
